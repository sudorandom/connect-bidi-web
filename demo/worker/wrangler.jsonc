{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connect-bidi-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  // Custom domain: Cloudflare creates the DNS record and certificate on
  // deploy (the kmcd.dev zone must be in the same Cloudflare account).
  "routes": [
    { "pattern": "connect-bidi-web.kmcd.dev", "custom_domain": true }
  ],
  // The custom domain is canonical; don't also serve from *.workers.dev.
  "workers_dev": false,
  "assets": {
    // The built demo site; run `npm run build` in demo/web first.
    "directory": "../web/dist",
    // Assets normally win for matching GET requests; these paths must always
    // reach the worker (WebSocket upgrade and RPCs)
    "run_worker_first": [
      "/websocket",
      "/connectbidi.eliza.v1.ElizaService/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
