{
  "name": "@sudorandom/connect-bidi-node",
  "version": "0.1.0",
  "description": "Node.js WebSocket adapter for ConnectRPC bidirectional streaming (see @sudorandom/connect-bidi-core)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudorandom/connect-bidi-web.git",
    "directory": "ts/packages/node"
  },
  "scripts": {
    "generate": "buf generate ../../../proto",
    "prebuild": "rm -rf ./dist/*",
    "build": "tsc --project tsconfig.build.json --outDir ./dist",
    "test": "tsc --noEmit && node --import tsx --test $(find src -name '*.spec.ts')",
    "interop:eliza": "tsx interop/server.ts",
    "format": "biome format --write .",
    "lint": "biome lint --error-on-warnings .",
    "attw": "attw --pack --profile esm-only"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@sudorandom/connect-bidi-core": "^0.1.0",
    "ws": "^8.21.2"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.7.0",
    "@connectrpc/connect": "^2.1.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  }
}
