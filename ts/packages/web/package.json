{
  "name": "@sudorandom/connect-bidi-web",
  "version": "0.1.0",
  "description": "WebSocket and WebTransport client transports for ConnectRPC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudorandom/connect-bidi-web.git",
    "directory": "ts/packages/web"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist/*",
    "build": "tsc --project tsconfig.build.json --outDir ./dist",
    "test": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint --error-on-warnings .",
    "attw": "attw --pack --profile esm-only"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.7.0",
    "@connectrpc/connect": "^2.1.0"
  }
}
